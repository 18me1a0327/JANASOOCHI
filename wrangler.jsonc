{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "janasoochi",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./lib/cloudflare/worker.ts",
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
