JANASOOCHI_EXTRACTION_ENVIRONMENT=development
JANASOOCHI_EXTRACTION_LOG_LEVEL=INFO
JANASOOCHI_EXTRACTION_MAX_UPLOAD_MIB=75
JANASOOCHI_EXTRACTION_DEFAULT_RENDER_DPI=300
JANASOOCHI_EXTRACTION_MAX_RENDER_DPI=400
JANASOOCHI_EXTRACTION_CORS_ORIGINS=http://localhost:3000

# Backend-only values for the future Supabase job repository.
# Never expose either value through NEXT_PUBLIC_* variables.
JANASOOCHI_EXTRACTION_SUPABASE_URL=
JANASOOCHI_EXTRACTION_SUPABASE_SECRET_KEY=
